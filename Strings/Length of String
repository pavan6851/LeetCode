#include <iostream>
#include <cstring>
using namespace std;

int getlength(char name[])
{
    int count = 0;
    for (int i = 0; i < name[i] != '\0'; i++)
    {
        count++;
    }
    return count;
}

int main()
{
    char name[20];

    cout << "enter name"<< endl;
    cin.getline(name, 20);

    cout << "length of string is: " << getlength(name)<< endl;

}
