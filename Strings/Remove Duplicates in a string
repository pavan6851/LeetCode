#include <iostream>
#include <unordered_set>
using namespace std;

int main()
{
    string s = "programming";
    string result = "";
    
    unordered_set<char> set;

    for(char c : s)
    {
        if(set.find(c) == set.end())
        {
            set.insert(c);
            result += c;
        }
    }

    cout << result << endl;
    return 0;
}
