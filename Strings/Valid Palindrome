class Solution {
public:
    bool isPalindrome(string s) 
    {
        string rstr;
        for(auto& c: s)
        {
            if(isalnum(c))
            {
                rstr.push_back(tolower(c));
            }    
        }
        if(rstr.empty())
        {
            return true;
        }
        string temp = rstr;
        reverse(rstr.begin(), rstr.end());
        return rstr == temp;
    }
};
