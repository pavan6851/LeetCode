#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* next;

    Node(int val)
    {
        data = val;
        next = NULL;
    }
};

struct List
{
    Node* head;
    Node* tail;

    List()
    {
        head = tail = NULL;
    }

    void pushfront(int val)
    {
        Node* newNode = new Node(val);

        if(head == NULL)
        {
            head = tail = newNode;
        }
        else
        {
            newNode->next = head;
            head = newNode;
        }
    }

    void insert(int val, int pos)
    {
        if(pos < 0)
        {
            cout << "invalid" << endl;
            return;
        }

        if(pos == 0)
        {
            pushfront(val);
            return;
        }

        Node* temp = head;
        for(int i = 0; i < pos - 1; i++)
        {
            temp = temp->next;
        }
        Node* newNode = new Node(val);

        newNode->next = temp->next;
        temp->next = newNode;
    }

    void display()
    {
        Node* temp = head;
        while(temp != NULL)
        {
            cout << temp->data << "->";
            temp = temp->next;
        }
        cout << "NULL" << endl;
    }
};

int main()
{
    List L;

    L.pushfront(4);
    L.pushfront(3);
    L.pushfront(2);
    L.pushfront(1);

    L.display();

    L.insert(5,2);
    L.display();
    return 0;
}
